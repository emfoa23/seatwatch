# Neon Postgres — neon.tech 콘솔에서 발급 (pooled connection string 권장)
DATABASE_URL=

# Aiven Valkey — 기존 인스턴스 재사용. URI 형식: rediss://default:<password>@<host>:<port>
VALKEY_URL=
VALKEY_KEY_PREFIX=seatwatch:dev

# Auth.js v5
# NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth — developers.kakao.com
# CLIENT_ID = REST API 키, SECRET = 보안에서 활성화 후 발급
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver OAuth — developers.naver.com → 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 토스페이먼츠 — tosspayments.com (개인 비사업자로 가입, 테스트 키부터)
# CLIENT_KEY 는 FE 노출 OK, SECRET_KEY 는 BE 전용
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# Resend — resend.com → API Keys (월 3,000건 무료)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sentry (선택)
SENTRY_DSN=
